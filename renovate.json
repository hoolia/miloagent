{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/vendor/**",
    "**/charts/**",
    "deploy/templates/**"
  ],
  "packageRules": [
    {
      "description": "passlib 1.7.x crashes on bcrypt 4.1 and later",
      "matchPackageNames": [
        "bcrypt"
      ],
      "allowedVersions": "<4.1"
    }
  ]
}
